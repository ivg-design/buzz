+/**
+ * Read the ACP v1 extension used by clients that need to append trusted
+ * session instructions while preserving Codex's built-in base prompt.
+ */
+function readDeveloperInstructions(meta: acp.NewSessionRequest["_meta"]): string | undefined {
+    const systemPrompt = meta?.["systemPrompt"];
+    if (systemPrompt === undefined) return undefined;
+    if (typeof systemPrompt !== "object" || systemPrompt === null || Array.isArray(systemPrompt)) {
+        throw RequestError.invalidParams(undefined, "_meta.systemPrompt must be an object");
+    }
+    const append = (systemPrompt as Record<string, unknown>)["append"];
+    if (typeof append !== "string" || append.trim().length === 0) {
+        throw RequestError.invalidParams(undefined, "_meta.systemPrompt.append must be a non-empty string");
+    }
+    return append;
+}
