+const BUZZ_JOB_POLICY_CAPABILITY = {
+  version: 1,
+  methods: ["session/new"],
+  nativeTools: "disabled",
+  mcp: "explicitOnly",
+  permissionRequests: "deny",
+} as const;
+
+const BUZZ_JOB_POLICY_KEYS = [
+  "ambientMcp",
+  "digest",
+  "nativeTools",
+  "permissionRequests",
+  "version",
+] as const;
+
+const BUZZ_JOB_NATIVE_TOOLS = [
+  "Bash",
+  "Read",
+  "Edit",
+  "Write",
+  "Glob",
+  "Grep",
+  "WebFetch",
+  "WebSearch",
+  "Task",
+  "Agent",
+  "Skill",
+  "NotebookEdit",
+  "TodoWrite",
+  "AskUserQuestion",
+  "EnterPlanMode",
+  "ExitPlanMode",
+  "KillShell",
+  "TaskOutput",
+] as const;
+
+type BuzzJobPolicyV1 = {
+  version: 1;
+  digest: string;
+  nativeTools: "disabled";
+  ambientMcp: "disabled";
+  permissionRequests: "deny";
 };

+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function hasExactKeys(value: Record<string, unknown>, expected: readonly string[]): boolean {
+  const actual = Object.keys(value).sort();
+  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
+}
+
+function isLoopbackHostname(hostname: string): boolean {
+  const unbracketed =
+    hostname.startsWith("[") && hostname.endsWith("]") ? hostname.slice(1, -1) : hostname;
+  if (isIP(unbracketed) === 4) return unbracketed.split(".")[0] === "127";
+  return isIP(unbracketed) === 6 && unbracketed === "::1";
+}
+
+function validateTrustedJobMcp(mcpServers: NewSessionRequest["mcpServers"]): void {
+  const [server] = mcpServers;
+  const candidate = server as unknown as Record<string, unknown> | undefined;
+  if (
+    mcpServers.length !== 1 ||
+    !isRecord(candidate) ||
+    !hasExactKeys(candidate, ["headers", "name", "type", "url"]) ||
+    candidate.type !== "http" ||
+    candidate.name !== "buzz-trusted-session" ||
+    typeof candidate.url !== "string" ||
+    !Array.isArray(candidate.headers) ||
+    candidate.headers.length !== 1
+  ) {
+    throw RequestError.invalidParams(
+      { mcpServers: "redacted" },
+      "JobPolicyV1 requires exactly one buzz-trusted-session loopback HTTP MCP",
+    );
+  }
+
+  let url: URL;
+  try {
+    url = new URL(candidate.url as string);
+  } catch {
+    throw RequestError.invalidParams({ mcpServers: "redacted" }, "JobPolicyV1 MCP URL is invalid");
+  }
+  if (
+    url.protocol !== "http:" ||
+    !isLoopbackHostname(url.hostname) ||
+    url.port === "" ||
+    url.pathname !== "/mcp" ||
+    url.username !== "" ||
+    url.password !== "" ||
+    url.search !== "" ||
+    url.hash !== ""
+  ) {
+    throw RequestError.invalidParams(
+      { mcpServers: "redacted" },
+      "JobPolicyV1 MCP must use an explicit loopback HTTP port and exact /mcp path",
+    );
+  }
+
+  const [header] = candidate.headers as unknown[];
+  if (
+    !isRecord(header) ||
+    !hasExactKeys(header, ["name", "value"]) ||
+    header.name !== "Authorization" ||
+    typeof header.value !== "string" ||
+    !/^Bearer [0-9a-f]{64}$/.test(header.value)
+  ) {
+    throw RequestError.invalidParams(
+      { mcpServers: "redacted" },
+      "JobPolicyV1 MCP requires one exact lowercase-SHA256 bearer header",
+    );
+  }
+}
+
+function parseBuzzJobPolicy(params: NewSessionRequest): BuzzJobPolicyV1 | undefined {
+  const meta = params._meta;
+  if (!isRecord(meta) || !isRecord(meta.buzz) || !("jobPolicy" in meta.buzz)) return undefined;
+  const policy = meta.buzz.jobPolicy;
+  if (
+    !isRecord(policy) ||
+    !hasExactKeys(policy, BUZZ_JOB_POLICY_KEYS) ||
+    policy.version !== 1 ||
+    typeof policy.digest !== "string" ||
+    !/^[0-9a-f]{64}$/.test(policy.digest) ||
+    policy.nativeTools !== "disabled" ||
+    policy.ambientMcp !== "disabled" ||
+    policy.permissionRequests !== "deny"
+  ) {
+    throw RequestError.invalidParams(
+      { jobPolicy: "redacted" },
+      "Invalid immutable Buzz JobPolicyV1 declaration",
+    );
+  }
+  validateTrustedJobMcp(params.mcpServers);
+  return policy as BuzzJobPolicyV1;
+}
+
+function canUseBuzzJobTool(): CanUseTool {
+  return async (toolName, toolInput) => {
+    if (toolName.startsWith("mcp__buzz-trusted-session__")) {
+      return { behavior: "allow", updatedInput: toolInput };
+    }
+    return {
+      behavior: "deny",
+      message: "JobPolicyV1 permits only the scoped buzz-trusted-session MCP",
+    };
+  };
+}
+
