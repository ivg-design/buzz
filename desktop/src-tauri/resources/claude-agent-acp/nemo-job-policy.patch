@@ -0,0 +1,241 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type {
+  ClientCapabilities,
+  NewSessionRequest,
+  SessionNotification,
+} from "@agentclientprotocol/sdk";
+import type { CanUseTool, Options } from "@anthropic-ai/claude-agent-sdk";
+import type { AcpClient, ClaudeAcpAgent as ClaudeAcpAgentType } from "../acp-agent.js";
+
+let capturedOptions: Options | undefined;
+let queryCalls = 0;
+
+vi.mock("@anthropic-ai/claude-agent-sdk", async () => {
+  const actual = await vi.importActual<typeof import("@anthropic-ai/claude-agent-sdk")>(
+    "@anthropic-ai/claude-agent-sdk",
+  );
+  const { makeMockQuery } = await import("./helpers.js");
+  return {
+    ...actual,
+    query: (args: { prompt: unknown; options: Options }) => {
+      queryCalls += 1;
+      capturedOptions = args.options;
+      return makeMockQuery({
+        initializationResult: async () => ({
+          models: [
+            {
+              value: "claude-sonnet-4-6",
+              displayName: "Claude Sonnet",
+              description: "Fast",
+              supportsAutoMode: true,
+            },
+          ],
+        }),
+      });
+    },
+  };
+});
+
+const DIGEST = "a".repeat(64);
+const TOKEN = "b".repeat(64);
+
+function validJobRequest(): NewSessionRequest {
+  return {
+    cwd: process.cwd(),
+    mcpServers: [
+      {
+        type: "http",
+        name: "buzz-trusted-session",
+        url: "http://127.0.0.1:32123/mcp",
+        headers: [{ name: "Authorization", value: `Bearer ${TOKEN}` }],
+      },
+    ],
+    _meta: {
+      buzz: {
+        jobPolicy: {
+          version: 1,
+          digest: DIGEST,
+          nativeTools: "disabled",
+          ambientMcp: "disabled",
+          permissionRequests: "deny",
+        },
+      },
+    },
+  };
+}
+
+describe("Buzz JobPolicyV1", () => {
+  let agent: ClaudeAcpAgentType;
+  let requestPermission: ReturnType<typeof vi.fn>;
+
+  beforeEach(async () => {
+    capturedOptions = undefined;
+    queryCalls = 0;
+    requestPermission = vi.fn(async () => ({ outcome: { outcome: "cancelled" } }));
+    vi.resetModules();
+    const { ClaudeAcpAgent } = await import("../acp-agent.js");
+    const client = {
+      sessionUpdate: async (_notification: SessionNotification) => {},
+      requestPermission,
+      readTextFile: async () => ({ content: "" }),
+      writeTextFile: async () => ({}),
+    } as unknown as AcpClient;
+    agent = new ClaudeAcpAgent(client);
+  });
+
+  it("advertises the exact immutable job capability", async () => {
+    const response = await agent.initialize({
+      protocolVersion: 1,
+      clientCapabilities: {} as ClientCapabilities,
+    });
+
+    expect(response._meta?.buzz).toEqual({
+      jobPolicy: {
+        version: 1,
+        methods: ["session/new"],
+        nativeTools: "disabled",
+        mcp: "explicitOnly",
+        permissionRequests: "deny",
+      },
+    });
+  });
+
+  it("rejects malformed policies and non-exact trusted MCP declarations before query creation", async () => {
+    const cases: NewSessionRequest[] = [];
+
+    const uppercaseDigest = validJobRequest();
+    (uppercaseDigest._meta!.buzz as { jobPolicy: { digest: string } }).jobPolicy.digest =
+      "A".repeat(64);
+    cases.push(uppercaseDigest);
+
+    const extraPolicyField = validJobRequest();
+    (extraPolicyField._meta!.buzz as { jobPolicy: Record<string, unknown> }).jobPolicy.extra = true;
+    cases.push(extraPolicyField);
+
+    const queryUrl = validJobRequest();
+    (queryUrl.mcpServers[0] as { url: string }).url += "?escape=1";
+    cases.push(queryUrl);
+
+    const remoteUrl = validJobRequest();
+    (remoteUrl.mcpServers[0] as { url: string }).url = "http://example.test:32123/mcp";
+    cases.push(remoteUrl);
+
+    const extraHeader = validJobRequest();
+    (extraHeader.mcpServers[0] as { headers: Array<{ name: string; value: string }> }).headers.push(
+      {
+        name: "X-Extra",
+        value: "not-allowed",
+      },
+    );
+    cases.push(extraHeader);
+
+    const extraServer = validJobRequest();
+    extraServer.mcpServers.push({
+      name: "ambient",
+      command: "/bin/false",
+      args: [],
+      env: [],
+    });
+    cases.push(extraServer);
+
+    for (const request of cases) {
+      await expect(agent.newSession(request)).rejects.toThrow(/JobPolicyV1/);
+    }
+    expect(queryCalls).toBe(0);
+  });
+
+  it("hard-overrides every ambient execution surface and returns the exact acknowledgement", async () => {
+    const request = validJobRequest();
+    request.additionalDirectories = ["/Users/Shared"];
+    request._meta = {
+      ...request._meta,
+      additionalRoots: ["/Volumes"],
+      claudeCode: {
+        emitRawSDKMessages: true,
+        options: {
+          tools: ["Bash", "Read"],
+          settingSources: ["user", "project", "local"],
+          strictMcpConfig: false,
+          permissionMode: "bypassPermissions",
+          allowDangerouslySkipPermissions: true,
+          additionalDirectories: ["/tmp/escape"],
+          agents: { escape: { description: "escape", prompt: "escape" } },
+          agent: "escape",
+          plugins: [{ type: "local", path: "/tmp/plugin" }],
+          skills: "all",
+          hooks: { PreToolUse: [] },
+          mcpServers: {
+            ambient: { type: "stdio", command: "/bin/false", args: [] },
+          },
+          settings: { permissions: { allow: ["Bash"] } },
+          extraArgs: { "plugin-dir": "/tmp/plugin" },
+        },
+      },
+    };
+
+    const response = await agent.newSession(request);
+
+    expect(response._meta).toEqual({
+      buzz: { jobPolicy: { version: 1, applied: true, digest: DIGEST } },
+    });
+    expect(capturedOptions).toMatchObject({
+      tools: [],
+      settingSources: [],
+      strictMcpConfig: true,
+      permissionMode: "dontAsk",
+      allowDangerouslySkipPermissions: false,
+      additionalDirectories: [],
+      forwardSubagentText: false,
+      agents: {},
+      plugins: [],
+      skills: [],
+      hooks: {},
+      extraArgs: { "replay-user-messages": "" },
+    });
+    expect(capturedOptions?.settings).toBeUndefined();
+    expect(capturedOptions?.agent).toBeUndefined();
+    expect(capturedOptions?.mcpServers).toEqual({
+      "buzz-trusted-session": {
+        type: "http",
+        url: "http://127.0.0.1:32123/mcp",
+        headers: { Authorization: `Bearer ${TOKEN}` },
+      },
+    });
+    expect(capturedOptions?.disallowedTools).toEqual(
+      expect.arrayContaining([
+        "Bash",
+        "Read",
+        "Edit",
+        "Write",
+        "Glob",
+        "Grep",
+        "WebFetch",
+        "WebSearch",
+        "Task",
+        "Agent",
+        "Skill",
+        "AskUserQuestion",
+      ]),
+    );
+  });
+
+  it("allows only the scoped trusted MCP without consulting ACP permissions", async () => {
+    await agent.newSession(validJobRequest());
+    const canUseTool = capturedOptions?.canUseTool as CanUseTool;
+    const callbackOptions = {
+      signal: new AbortController().signal,
+      toolUseID: "tool-1",
+    } as Parameters<CanUseTool>[2];
+
+    await expect(
+      canUseTool("mcp__buzz-trusted-session__git_status", { path: "." }, callbackOptions),
+    ).resolves.toEqual({ behavior: "allow", updatedInput: { path: "." } });
+    await expect(canUseTool("Bash", { command: "id" }, callbackOptions)).resolves.toMatchObject({
+      behavior: "deny",
+    });
+    await expect(canUseTool("mcp__ambient__escape", {}, callbackOptions)).resolves.toMatchObject({
+      behavior: "deny",
+    });
+    expect(requestPermission).not.toHaveBeenCalled();
+  });
+});
